# --- Database ---
DB_NAME=carepoint
DB_USER=carepoint
DB_PASSWORD=carepoint_dev
DB_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/carepoint
DB_POOL_MAX=10

# --- Application ---
SPRING_PROFILES_ACTIVE=local

# --- Auth (M2+) — generate a real random value, never commit a real secret ---
JWT_SIGNING_KEY=change-me-32+-chars-random
# inactivity sign-out: server window = frontend NEXT_PUBLIC_SESSION_IDLE_MINUTES + 1m keep-alive margin
SESSION_IDLE_TIMEOUT=16m

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (ADR-0004) ---
# local = disk under STORAGE_LOCAL_DIR (dev/test, zero cloud account)
# r2 = S3-compatible object storage (deployed envs only)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/media/local
# Required only when STORAGE_PROVIDER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carepoint-media
R2_PUBLIC_BASE_URL=

# --- Rate limits (defaults in docs/06) ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_OTP_PER_MIN=10
RATE_LIMIT_AVAILABILITY_PER_MIN=60
RATE_LIMIT_BOOKING_PER_MIN=10
RATE_LIMIT_MEDIA_UPLOAD_PER_MIN=20

# --- Email / OTP ---
# log = codes printed to app logs (dev default, no account needed)
# smtp = real mail via SMTP_* below
MAIL_PROVIDER=log
OTP_TTL=2m
OTP_MAX_ATTEMPTS=4
OTP_MAX_SENDS=4
OTP_RESEND_COOLDOWN=104s
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail app password — Google Account → Security → App passwords (no spaces)
SMTP_PASS=your-gmail-app-password

# --- Google sign-in ---
# Same client id, two consumers: backend verifies the token, frontend renders
# the GIS button. NEXT_PUBLIC_* is public by design (it's a client id, not a secret).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
